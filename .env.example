# UniHR Environment Variables Example
DATABASE_URL="postgresql://unihr:unihr@localhost:5432/unihr?schema=public"
# DATABASE_URL="file:../db/custom.db"
NEXTAUTH_SECRET=your-64-character-random-hex-secret-here
BIOMETRIC_API_KEY=your-48-character-plus-random-hex-biometric-key

# Transactional Email (Resend HTTP API)
# Set to "true" to send live emails; defaults to "false" (no-op dev/CI logging mode)
EMAIL_ENABLED="false"
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="UniHR <notifications@unihr.local>"
NEXTAUTH_URL="http://localhost:3001"

# S3-Compatible Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi)
# Leave S3_ACCESS_KEY_ID unset for simulated/mock direct upload URLs in local dev and CI
S3_BUCKET="unihr-documents"
S3_REGION="ap-south-1"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
