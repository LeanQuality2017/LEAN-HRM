// UniHR — Unified Multi-Company HRMS
// 3 companies in one system: 2 normal + 1 training & placement institute
// NOTE: SQLite has no native enums — statuses are Strings with constants in src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============ ORGANIZATION ============

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String   @default("NORMAL") // NORMAL | INSTITUTE
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments   EmployeeCompanyAssignment[]
  departments   Department[]
  leaveTypes    LeaveType[]
  jobOpenings   JobOpening[]
  workReports   DailyWorkReport[]
  attendance    Attendance[]
  announcements Announcement[]
  userScopes    UserCompanyScope[]
  payRule       CompanyPayRule?
  payrollRuns   PayrollRun[]
  attendanceSummaries AttendanceSummary[]
  shifts        Shift[]
  holidays      Holiday[]
  regularisations AttendanceRegularisation[]
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  companyIdCompany Company @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([companyId, name])
}

// ============ USERS & EMPLOYEES ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("EMPLOYEE") // SUPER_ADMIN | COMPANY_ADMIN | HR | MANAGER | EMPLOYEE | STUDENT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee         Employee?
  student          Student?
  notifications    Notification[]
  announcements    Announcement[]
  reviewsGiven     PerformanceReview[] @relation("Reviewer")
  workReportComments WorkReportComment[]
  payrollsGenerated  Payroll[]           @relation("PayrollGenerator")
  leaveReviews       LeaveRequest[]      @relation("LeaveReviewer")
  feesReceived       FeePayment[]        @relation("FeeReceiver")
  companyScopes      UserCompanyScope[]
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
  salaryRevisionsGiven EmployeeSalaryRevision[] @relation("SalaryReviser")
  payrollRunsRun     PayrollRun[]              @relation("PayrollRunner")
  documentsUploaded  Document[]                @relation("DocumentUploader")
  regularisationsReviewed AttendanceRegularisation[] @relation("RegReviewer")
}

model Employee {
  id           String   @id @default(cuid())
  userId       String   @unique
  employeeCode String   @unique
  designation  String   @default("Employee")
  joinedAt     DateTime @default(now())
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE
  baseSalary   Decimal  @default(0) @db.Decimal(12, 2)
  managerId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User      @relation(fields: [userId], references: [id])
  manager    Employee? @relation("ReportingTree", fields: [managerId], references: [id])
  directReports Employee[] @relation("ReportingTree")

  assignments     EmployeeCompanyAssignment[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  payrolls        Payroll[]
  workReports     DailyWorkReport[]
  reviews         PerformanceReview[] @relation("Reviewee")
  kpis            KPI[]
  salaryStructures    SalaryStructure[]
  salaryRevisions     EmployeeSalaryRevision[]
  statutoryProfile    StatutoryProfile?
  payrollLines        PayrollLine[]
  attendanceSummaries AttendanceSummary[]
  shiftAssignments    EmployeeShiftAssignment[]
  regularisations     AttendanceRegularisation[]
}

// Shared employees: one person can work for multiple companies; single login
model EmployeeCompanyAssignment {
  id          String  @id @default(cuid())
  employeeId  String
  companyId   String
  isPrimary   Boolean @default(false)
  designation String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, companyId])
  @@index([companyId])
}

model UserCompanyScope {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

// ============ ATTENDANCE & LEAVE ============

// Overnight shifts: an attendance row belongs to the SHIFT DATE = the date of check-in, in the company's local timezone.
// A shift starting 22:00 on 10 Jun and ending 06:00 on 11 Jun is ONE row dated 2026-06-10.
model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  companyId  String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status           String    @default("PRESENT") // PRESENT | LATE | HALF_DAY | ABSENT | LEAVE | WFH | HOLIDAY
  source           String    @default("WEB")     // WEB | BIOMETRIC | MANUAL
  note             String?
  lateMinutes      Int       @default(0)
  earlyExitMinutes Int       @default(0)
  otMinutes        Int       @default(0)
  isLop            Boolean   @default(false)
  shiftId          String?
  classifiedAt     DateTime?
  createdAt        DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@unique([employeeId, companyId, date], name: "employeeId_companyId_date")
  @@index([companyId])
  @@index([date])
  @@index([companyId, date])
  @@index([shiftId])
}

model LeaveType {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  daysPerYear Int     @default(12)
  isUnpaid    Boolean @default(false)

  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests    LeaveRequest[]
  accrualRule LeaveAccrualRule?
  balances    LeaveBalance[]

  @@unique([companyId, name])
}

model LeaveAccrualRule {
  id              String   @id @default(cuid())
  leaveTypeId     String   @unique
  frequency       String   // MONTHLY | QUARTERLY | YEARLY | UPFRONT
  amount          Decimal  @db.Decimal(6, 2)
  carryForwardCap Decimal  @default(0) @db.Decimal(6, 2)
  expiryMonths    Int      @default(0)
  proRateOnJoin   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([leaveTypeId])
}

model LeaveBalance {
  id               String   @id @default(cuid())
  employeeId       String
  leaveTypeId      String
  year             Int
  credited         Decimal  @db.Decimal(6, 2)
  used             Decimal  @default(0) @db.Decimal(6, 2)
  carriedForward   Decimal  @default(0) @db.Decimal(6, 2)
  lapsed           Decimal  @default(0) @db.Decimal(6, 2)
  lastAccruedMonth Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
  @@index([leaveTypeId])
}

model LeaveRequest {
  id            String    @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  days          Float
  reason        String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  reviewedById  String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id])
  reviewedBy User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([leaveTypeId])
}

// ============ PAYROLL (LEGACY V1 & ENGINE V2) ============

// Legacy Payroll model kept reading-compatible for existing routes and historical queries.
// Architectural mapping from Legacy v1 -> Engine v2:
// - Company batch approval / locked state: Payroll -> PayrollRun
// - Line-item individual payslip & calculations: Payroll -> PayrollLine
// - Salary definition: Employee.baseSalary -> SalaryStructure & SalaryComponent
// - Salary change history: Employee.baseSalary overwrite -> EmployeeSalaryRevision
// - Tax/statutory profile: hardcoded formula -> StatutoryProfile
// - Attendance/loss-of-pay inputs: raw dates -> AttendanceSummary
model Payroll {
  id            String    @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  basic         Decimal   @db.Decimal(12, 2)
  allowances    Decimal   @default(0) @db.Decimal(12, 2)
  deductions    Decimal   @default(0) @db.Decimal(12, 2)
  netPay        Decimal   @db.Decimal(12, 2)
  status        String    @default("DRAFT") // DRAFT | PROCESSED | PAID
  paidAt        DateTime?
  generatedById String?
  createdAt     DateTime  @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy User?    @relation("PayrollGenerator", fields: [generatedById], references: [id])

  @@unique([employeeId, month, year])
}

model CompanyPayRule {
  id               String   @id @default(cuid())
  companyId        String   @unique
  workingDaysBasis String   @default("CALENDAR") // CALENDAR | FIXED_26 | FIXED_30
  lopDivisor       Decimal? @db.Decimal(5, 2)    // null = use workingDaysBasis
  otMultiplier     Decimal  @default(1.50) @db.Decimal(4, 2)
  payrollCutoffDay Int      @default(25)
  currency         String   @default("INR")
  timezone         String   @default("Asia/Kolkata")
  regularisationWindowDays Int @default(7)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SalaryStructure {
  id            String    @id @default(cuid())
  employeeId    String
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = currently active structure
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components SalaryComponent[]

  @@index([employeeId, effectiveFrom])
}

model SalaryComponent {
  id          String   @id @default(cuid())
  structureId String
  name        String   // BASIC | HRA | SPECIAL_ALLOWANCE | CONVEYANCE | etc.
  type        String   // EARNING | DEDUCTION
  amount      Decimal  @db.Decimal(12, 2)
  isTaxable   Boolean  @default(true)
  isStatutory Boolean  @default(false)
  createdAt   DateTime @default(now())

  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model EmployeeSalaryRevision {
  id           String   @id @default(cuid())
  employeeId   String
  previousBase Decimal  @db.Decimal(12, 2)
  newBase      Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime
  reason       String?
  revisedById  String?
  createdAt    DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  revisedBy User?    @relation("SalaryReviser", fields: [revisedById], references: [id])

  @@index([employeeId, effectiveFrom])
}

model StatutoryProfile {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  pfApplicable  Boolean  @default(true)
  pfCeiling     Boolean  @default(true) // Capped at statutory wage ceiling (e.g. ₹15,000)
  esiApplicable Boolean  @default(false)
  ptState       String   @default("TN") // State tax code (e.g. TN | KA | MH)
  tdsRegime     String   @default("NEW") // NEW | OLD
  declarations  String?  // JSON serialized regime declarations
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PayrollRun {
  id              String    @id @default(cuid())
  companyId       String
  month           Int
  year            Int
  status          String    @default("DRAFT") // DRAFT | LOCKED | PROCESSED | PAID
  runById         String?
  lockedAt        DateTime?
  processedAt     DateTime?
  paidAt          DateTime?
  totalGross      Decimal   @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal   @default(0) @db.Decimal(14, 2)
  totalStatutory  Decimal   @default(0) @db.Decimal(14, 2)
  totalNet        Decimal   @default(0) @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runBy   User?         @relation("PayrollRunner", fields: [runById], references: [id])
  lines   PayrollLine[]

  @@unique([companyId, month, year])
  @@index([companyId, status])
}

model PayrollLine {
  id                 String   @id @default(cuid())
  runId              String
  employeeId         String
  gross              Decimal  @db.Decimal(12, 2)
  deductions         Decimal  @db.Decimal(12, 2)
  statutory          Decimal  @db.Decimal(12, 2)
  tds                Decimal? @default(0) @db.Decimal(12, 2)
  net                Decimal  @db.Decimal(12, 2)
  daysPaid           Decimal  @default(0) @db.Decimal(5, 2)
  lopDays            Decimal  @default(0) @db.Decimal(5, 2)
  componentBreakdown String?  // JSON snapshot of component calculations
  createdAt          DateTime @default(now())

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([runId, employeeId])
  @@index([runId])
  @@index([employeeId])
}

model AttendanceSummary {
  id          String   @id @default(cuid())
  employeeId  String
  companyId   String
  month       Int
  year        Int
  presentDays Decimal  @default(0) @db.Decimal(5, 2)
  lopDays     Decimal  @default(0) @db.Decimal(5, 2)
  otHours     Decimal  @default(0) @db.Decimal(6, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, companyId, month, year])
  @@index([companyId, month, year])
}

// ============ WORK MONITORING (Daily EOD Reports) ============

model DailyWorkReport {
  id          String   @id @default(cuid())
  employeeId  String
  companyId   String
  date        DateTime
  tasks       String
  hoursWorked Float    @default(8)
  blockers    String?
  status      String   @default("SUBMITTED") // SUBMITTED | REVIEWED
  createdAt   DateTime @default(now())

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company             @relation(fields: [companyId], references: [id])
  comments WorkReportComment[]

  @@unique([employeeId, date])
  @@unique([employeeId, companyId, date], name: "employeeId_companyId_date")
  @@index([companyId])
  @@index([date])
}

model WorkReportComment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  report DailyWorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id])

  @@index([reportId])
}

// ============ RECRUITMENT (ATS) ============

model JobOpening {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  department  String?
  description String?
  openings    Int      @default(1)
  status      String   @default("OPEN") // OPEN | ON_HOLD | CLOSED
  createdAt   DateTime @default(now())

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId])
}

model JobApplication {
  id           String   @id @default(cuid())
  jobOpeningId String
  name         String
  email        String
  phone        String?
  experience   Float    @default(0)
  resumeNote   String?
  status       String   @default("NEW") // NEW | SCREENING | INTERVIEW | OFFER | HIRED | REJECTED
  notes        String?
  createdAt    DateTime @default(now())

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId])
}

// ============ PERFORMANCE ============

model PerformanceReview {
  id         String   @id @default(cuid())
  employeeId String
  reviewerId String
  period     String // e.g. "2026-Q1"
  goals      String
  rating     Float?
  comments   String?
  status     String   @default("PENDING") // PENDING | COMPLETED
  createdAt  DateTime @default(now())

  employee Employee @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer User     @relation("Reviewer", fields: [reviewerId], references: [id])

  @@unique([employeeId, period])
}

model KPI {
  id         String @id @default(cuid())
  employeeId String
  title      String
  target     Float
  achieved   Float  @default(0)
  unit       String @default("%")
  period     String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ============ TRAINING & PLACEMENT INSTITUTE ============

model Student {
  id            String   @id @default(cuid())
  userId        String?  @unique
  code          String   @unique
  name          String
  email         String?
  phone         String?
  qualification String?
  status        String   @default("ENQUIRY") // ENQUIRY | ENROLLED | IN_TRAINING | TRAINED | PLACED | DROPPED
  createdAt     DateTime @default(now())

  user        User?               @relation(fields: [userId], references: [id])
  enrollments StudentEnrollment[]
  payments    FeePayment[]
  results     AssessmentResult[]
  placements  Placement[]
}

model Course {
  id            String @id @default(cuid())
  name          String
  code          String @unique
  description   String?
  durationWeeks Int     @default(8)
  fee           Decimal @default(0) @db.Decimal(12, 2)

  batches Batch[]
}

model Batch {
  id        String    @id @default(cuid())
  courseId  String
  name      String
  startDate DateTime
  endDate   DateTime?
  capacity  Int       @default(30)
  status    String    @default("UPCOMING") // UPCOMING | ONGOING | COMPLETED

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  assessments Assessment[]

  @@index([courseId])
}

model StudentEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  batchId    String
  status     String   @default("ACTIVE") // ACTIVE | COMPLETED | DROPPED
  enrolledAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([batchId])
}

model FeePayment {
  id           String   @id @default(cuid())
  studentId    String
  amount       Decimal  @db.Decimal(12, 2)
  method       String   @default("CASH") // CASH | UPI | BANK | CARD
  invoiceNo    String   @unique
  note         String?
  paidAt       DateTime @default(now())
  receivedById String?

  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  receivedBy  User?   @relation("FeeReceiver", fields: [receivedById], references: [id])

  @@index([studentId])
}

model Assessment {
  id       String   @id @default(cuid())
  batchId  String
  title    String
  date     DateTime
  maxScore Float    @default(100)

  batch   Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  results AssessmentResult[]

  @@index([batchId])
}

model AssessmentResult {
  id           String  @id @default(cuid())
  assessmentId String
  studentId    String
  score        Float
  remarks      String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model Placement {
  id          String   @id @default(cuid())
  studentId   String
  companyName String
  role        String
  salary      Decimal? @db.Decimal(12, 2)
  placedAt    DateTime
  status      String   @default("PLACED") // PLACED | JOINED | WITHDRAWN

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ============ COMMUNICATION ============

model Announcement {
  id          String   @id @default(cuid())
  companyId   String?
  title       String
  content     String
  createdById String
  createdAt   DateTime @default(now())

  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User     @relation(fields: [createdById], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ============ AUDIT ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

// ============ AUTH & NOTIFICATIONS ============

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String?
  status    String   // SENT | FAILED | NOOP_DEV
  error     String?
  createdAt DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

// ============ DOCUMENT STORAGE ============

model Document {
  id          String    @id @default(cuid())
  ownerType   String    // COMPANY | EMPLOYEE | AUDIT | STUDENT
  ownerId     String    // Foreign key identifier to owner record
  type        String    // CONTRACT | POLICY | ID_PROOF | RESUME | PAYSLIP | AUDIT_REPORT | OTHER
  expiryDate  DateTime?
  fileKey     String    @unique // S3 / Object Storage object key
  fileName    String?   // Original uploaded file name
  mime        String    // Validated MIME type
  size        Int       // File size in bytes
  uploadedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uploader User? @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([ownerType, ownerId])
  @@index([expiryDate])
  @@index([fileKey])
  @@index([uploadedBy])
}

// ============ SHIFTS, HOLIDAYS & ATTENDANCE REGULARISATION ============

model Shift {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  startTime     String   // "HH:mm" in company local time, e.g. "09:30"
  endTime       String   // "HH:mm"; if endTime <= startTime the shift is overnight
  breakMinutes  Int      @default(60)
  graceMinutes  Int      @default(15)
  isDefault     Boolean  @default(false)
  weekoffMultiplier Decimal @default(2.00) @db.Decimal(4,2)
  createdAt     DateTime @default(now())

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments   EmployeeShiftAssignment[]
  attendance    Attendance[]

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeShiftAssignment {
  id         String   @id @default(cuid())
  employeeId String
  shiftId    String
  effectiveFrom DateTime
  effectiveTo   DateTime?

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
  @@index([shiftId])
}

model Holiday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime // normalised DATE in company local time
  name      String
  isOptional Boolean @default(false)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
}

model AttendanceRegularisation {
  id             String   @id @default(cuid())
  employeeId     String
  companyId      String
  attendanceId   String?
  date           DateTime
  requestedStatus String  // PRESENT | HALF_DAY | WFH | ABSENT
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason         String
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById   String?
  reviewComment  String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer   User?    @relation("RegReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId, status])
  @@index([companyId, status])
}

